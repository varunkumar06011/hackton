# Copy to .env for local dev, or set in Vercel project settings for production.
# Vite only exposes env vars prefixed with VITE_ to the client.

# Backend API base URL. Local dev falls back to http://localhost:8000/api if unset.
# For production, set this to your Railway backend URL, e.g.:
# VITE_API_BASE=https://your-app.up.railway.app/api
VITE_API_BASE=http://localhost:8000/api
